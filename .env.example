# Tarjuman configuration. Copy this file to ".env" and fill in what you need.
# Everything is optional: with no keys at all, typed text is still translated and spoken.

# ---------------------------------------------------------------------------
# API keys (both recommended keys are free and need no credit card)
# ---------------------------------------------------------------------------
# Keys can also be pasted in the app under Settings -> API keys. Values set
# here take precedence and cannot be changed from the app.

# Groq: speech recognition (Whisper large-v3) and fast translation models.
# This is the one key Tarjuman needs to understand speech.
# Get it at https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio (Gemini): hears the audio and translates in one step; the most
# accurate option for Urdu. Get it at https://aistudio.google.com/apikey
# Note: Google's terms require its paid tier for applications offered to users in the
# EEA, the UK and Switzerland. Check them before relying on the free tier there.
GEMINI_API_KEY=

# Optional. Azure AI Speech: the official API for the same neural voices
# (free F0 tier: 0.5 million characters per month). Either write the key as
# "region:key" (for example westeurope:0123abcd...) or set the region separately.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional. Any OpenAI-compatible chat endpoint as an extra translator:
# OpenRouter, a paid provider, or a local model server. Example for Ollama:
#   OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
#   OPENAI_COMPAT_MODEL=gemma3:12b
# (no key needed for a local server)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=

# Optional. An e-mail address raises the daily quota of the keyless MyMemory
# fallback translator from 5,000 to 50,000 characters.
MYMEMORY_EMAIL=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
# Keep 127.0.0.1 unless other machines must reach the server. Any other value
# requires ACCESS_TOKEN (the server refuses to start without it).
HOST=127.0.0.1
# When set (at least 8 characters), open the app as http://host:port/?token=<value>
ACCESS_TOKEN=
# Only behind a reverse proxy: the address people open, e.g. https://tarjuman.example.com
# (requires ACCESS_TOKEN). Requests are then accepted from exactly this origin.
PUBLIC_ORIGIN=
# Where keys saved from the app are stored (file keys.json, readable only by you).
DATA_DIR=data
# Allow saving keys from the app. Defaults to on for a local server without ACCESS_TOKEN.
# KEYS_WRITABLE=1

# ---------------------------------------------------------------------------
# Models (defaults are chosen for accuracy first, then free quota)
# ---------------------------------------------------------------------------
# Comma-separated lists; the first entry is preferred. Providers retire model ids
# from time to time: if "npm run doctor" reports a model as not found, set a current one here.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMMA_MODEL=gemma-4-31b-it
# GROQ_STT_MODELS=whisper-large-v3,whisper-large-v3-turbo
# GROQ_MT_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Provider selection (comma-separated provider ids, tried first to last)
# ---------------------------------------------------------------------------
# A list is exclusive: only the listed providers are used; the others are never contacted.
# The ids are shown in square brackets by "npm run doctor" and in the provider lists that
# open from the status chips of the app.
# If MT_PROVIDERS does not include gemini-flash-lite, Gemini only transcribes Urdu and the
# translation is done by the listed translators.
# Without STT_PROVIDERS the order depends on the language: Gemini first for Urdu,
# Whisper first for German and English.
# STT_PROVIDERS=groq-whisper-large-v3,groq-whisper-large-v3-turbo
# MT_PROVIDERS=groq-gpt-oss-120b,gemini-flash-lite
# TTS_PROVIDERS=azure,edge

# ---------------------------------------------------------------------------
# Privacy and logging
# ---------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Transcripts and translations are never logged unless this is switched on (debugging only).
# LOG_TRANSCRIPTS=1

# Company proxy: HTTPS_PROXY can be set here for the keyless voice, but the requests to
# Groq, Google, Azure and MyMemory only use a proxy when Node is started with
# NODE_USE_ENV_PROXY=1 in the real environment (Node 22.21+), for example:
#   HTTPS_PROXY=http://proxy.example:3128 NODE_USE_ENV_PROXY=1 npm start
# HTTPS_PROXY=

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------
# Replace every provider with an offline fake (chimes instead of voices).
# Useful for trying the audio routing before signing up for anything.
# TARJUMAN_MOCK=1
